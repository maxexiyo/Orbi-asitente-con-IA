+def alarm_shake(t: float, since_beat: float, scale: float = 1.0):
+    """(dx, dy) en px de la sacudida de alarma: ráfaga rápida durante cada grupo de pitidos y quieta entre uno y otro.
+    t = reloj de animación; since_beat = segundos desde que empezó el último grupo de pitidos."""
+    if since_beat < 0 or since_beat > SHAKE_BURST_S:
+        return 0.0, 0.0
+    fade = 1.0 - 0.35 * (since_beat / SHAKE_BURST_S)          # un poco más suave hacia el final de la ráfaga
+    return math.sin(t * 58) * 12 * scale * fade, math.sin(t * 41 + 1.3) * 4 * scale * fade
+
