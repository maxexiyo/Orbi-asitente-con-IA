# Si ya tienes un .env con tus keys, no necesitas este archivo: se detectan solas.
# Todas en una sola variable también sirve:  GEMINI_API_KEYS=["AIza...","AIza..."]
# Puede haber varias keys: GEMINI_API_KEY_1, GEMINI_API_KEY_2... o una sola con comas.
GEMINI_API_KEY_1=AIza...
GEMINI_API_KEY_2=AIza...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...

# Opcionales
# LIVE_MODEL=gemini-3.8-live          (si tenías puesto gemini-3.1-flash-live-preview, bórralo o cámbialo: ese ya es "legacy")
# LIVE_VOICE=Puck
# HEADPHONES=true

# Casa inteligente (Home Assistant) — ver README, sección "Casa inteligente"
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=eyJ...

# Correo (solo lectura, Gmail por IMAP): contraseña de APLICACIÓN, no tu contraseña normal.
# El sufijo es el nombre de la cuenta de config.json en MAYÚSCULAS.
# ORBI_MAIL_PASS_PERSONAL=xxxx xxxx xxxx xxxx
# Calendarios también se pueden poner aquí:  ORBI_CAL_PERSONAL=https://...basic.ics
